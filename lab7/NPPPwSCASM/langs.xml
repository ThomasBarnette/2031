<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus modelFileLastModifiedDate="20250616">
    <!-- The key words of the supported languages, don't touch them! -->
    <!-- For languages like C/C++ substyle1..8 entries, you may enter your own keywords in those entries, 
        to have them show up in the "Default keywords" list shown in the Style Configurator -->
    <Languages>
        <Language name="normal" ext="txt" />
        <Language name="asm" ext="asm" commentLine=";" commentStart="" commentEnd="">
            <Keywords name="instre1">nop load store add sub jump jneg jpos jzero and or xor shift addi iload istore call return in out loadi sei cli reti jeq jne jnz sbs sbc</Keywords>
            <Keywords name="instre2" />
            <Keywords name="type1">dw</Keywords>
            <Keywords name="type2">org equ</Keywords>
            <Keywords name="type3" />
            <Keywords name="type4" />
            <!-- name="DIRECTIVES, FOLD OPEN" Keywords that start a fold region; these must *also* be in the DIRECTIVES category (name="type2") -->
            <Keywords name="type5" />
            <!-- name="DIRECTIVES, FOLD CLOSE" Keywords that close a fold region; these must *also* be in the DIRECTIVES category -->
            <Keywords name="type6" />
        </Language>
        <Language name="searchResult" ext="">
            <Keywords name="instre1" />
            <Keywords name="instre2" />
            <Keywords name="type1" />
        </Language>
    </Languages>
</NotepadPlus>
