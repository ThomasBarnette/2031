`timescale 1 ps/ 1 ps
module SCOMP_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clock;
reg [15:0] treg_IO_DATA;
reg resetn;
// wires                                               
wire [15:0] dbg_AC;
wire dbg_FETCH;
wire [15:0] dbg_IR;
wire [15:0] dbg_MD;
wire [10:0] dbg_NMA;
wire [10:0] dbg_PC;
wire [10:0] IO_ADDR;
wire [15:0] IO_DATA;
wire IO_READ;
wire IO_WRITE;

// assign statements (if any)                          
assign IO_DATA = treg_IO_DATA;
SCOMP i1 (
// port map - connection between master ports and signals/registers   
	.clock(clock),
	.dbg_AC(dbg_AC),
	.dbg_FETCH(dbg_FETCH),
	.dbg_IR(dbg_IR),
	.dbg_MD(dbg_MD),
	.dbg_NMA(dbg_NMA),
	.dbg_PC(dbg_PC),
	.IO_ADDR(IO_ADDR),
	.IO_DATA(IO_DATA),
	.IO_READ(IO_READ),
	.IO_WRITE(IO_WRITE),
	.resetn(resetn)
);
initial 
begin 
#10000000 $stop;
end 

// resetn
initial
begin
	resetn = 1'b0;
	resetn = #30000 1'b1;
end 

// clock
initial
begin
	clock = 1'b1;
	# 40000;
	repeat(124)
	begin
		clock = 1'b0;
		clock = #40000 1'b1;
		# 40000;
	end
	clock = 1'b0;
end 
endmodule

